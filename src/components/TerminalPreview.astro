---
import "@xterm/xterm/css/xterm.css";
import { terminalPreview, type Preview } from "../lib/renderer-previews";
const { id = "browser-preview", title = "Try it in your browser", preview } = Astro.props;
const examples = (preview ? [preview] : [terminalPreview("stat", "Stat"), terminalPreview("workspace-prompt", "Prompt")])
  .filter((item: Preview): item is Extract<Preview, { kind: "terminal" }> => item.kind === "terminal");
---
<section class="terminal-preview" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  {examples.length ? (
    <>
      {preview?.placeholder && <p>{preview.placeholder}</p>}
      <button type="button" data-launch>Start terminal demo</button>
      <p role="status" data-status></p>
      <div data-demo hidden>
        <div class="controls">
          {examples.length > 1 && examples.map(item => (
            <button type="button" data-choice={item.fixture} aria-pressed="false">{item.label}</button>
          ))}
          <button type="button" data-reset>Reset</button>
        </div>
        <p id={`${id}-help`} data-help></p>
        <div class="terminal-screen" data-screen role="region" aria-label="Meridian terminal" aria-describedby={`${id}-help`}></div>
      </div>
      <details open data-fallback>
        <summary>Text preview</summary>
        {examples.map(item => (
          <div data-example={item.fixture} data-label={item.label} data-recording={item.recording} data-interactive={String(item.interactive)}>
            {examples.length > 1 && <p>{item.label}</p>}
            <pre>{item.snapshot.trimEnd()}</pre>
          </div>
        ))}
      </details>
      <noscript><p>Enable JavaScript to load the terminal demo.</p></noscript>
    </>
  ) : <p>The terminal preview assets are unavailable in this build.</p>}
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(".terminal-preview")) {
    const launch = root.querySelector<HTMLButtonElement>("[data-launch]");
    if (!launch) continue;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const fallback = root.querySelector<HTMLDetailsElement>("[data-fallback]")!;
    launch.addEventListener("click", async () => {
      launch.disabled = true;
      status.textContent = "Loading the terminal demo…";
      try {
        const { mountPreview } = await import("../scripts/tui-preview");
        await mountPreview(root);
        fallback.open = false;
        launch.hidden = true;
      } catch {
        launch.disabled = false;
        fallback.open = true;
        status.textContent = "The terminal demo could not load. Try again or use the text preview.";
      }
    });
  }
</script>

<style>
  .terminal-preview { margin: 36px 0; }
  button { color: var(--cream); font: inherit; padding: 6px 10px; background: var(--ink-2); border: 1px solid var(--line-2); cursor: pointer; }
  button[aria-pressed="true"] { border-color: var(--amber); }
  button:disabled { cursor: wait; opacity: .65; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; }
  .terminal-screen { height: 19rem; max-inline-size: 100%; overflow: hidden; padding: 8px; background: var(--ink); border: 1px solid var(--line-2); }
  .terminal-screen:focus-within { outline: 2px solid var(--amber); outline-offset: 2px; }
  [data-help] { color: var(--muted); font-size: .9rem; }
  pre { max-inline-size: 100%; overflow: auto; padding: 8px; font: .78rem/1.5 var(--mono); }
  summary { cursor: pointer; }
</style>
