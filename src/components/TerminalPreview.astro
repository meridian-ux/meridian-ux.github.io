---
import "@xterm/xterm/css/xterm.css";
---
<section class="terminal-preview" id="browser-preview" aria-labelledby="preview-title">
  <h2 id="preview-title">Try it in your browser</h2>
  <p>Run the same Rust renderer used by the offline viewer. The demo loads WebAssembly and runs locally in xterm.js.</p>
  <button type="button" data-launch>Start terminal demo</button>
  <p role="status" data-status></p>
  <div data-demo hidden>
    <div class="controls" aria-label="Example">
      <button type="button" data-example="stat" aria-pressed="true">Stat</button>
      <button type="button" data-example="prompt" aria-pressed="false">Prompt</button>
      <button type="button" data-reset>Reset</button>
    </div>
    <p id="terminal-preview-help">Choose Prompt, focus the terminal, then type and press Enter. Press Escape to cancel or Tab to leave the terminal.</p>
    <div class="terminal-screen" data-screen role="region" aria-label="Meridian terminal" aria-describedby="terminal-preview-help"></div>
  </div>
  <details open data-fallback>
    <summary>Text preview</summary>
    <p><strong>Active employees</strong> 1,240, up 60 from the previous value. The prompt asks for a workspace name and confirms submission locally.</p>
  </details>
  <noscript><p>Enable JavaScript to load the terminal demo.</p></noscript>
</section>

<script>
  const root = document.querySelector<HTMLElement>(".terminal-preview");
  if (root) {
    const launch = root.querySelector<HTMLButtonElement>("[data-launch]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const demo = root.querySelector<HTMLElement>("[data-demo]")!;
    const screen = root.querySelector<HTMLElement>("[data-screen]")!;
    const fallback = root.querySelector<HTMLDetailsElement>("[data-fallback]")!;
    const choices = [...root.querySelectorAll<HTMLButtonElement>("[data-example]")];
    const reset = root.querySelector<HTMLButtonElement>("[data-reset]")!;

    launch.addEventListener("click", async () => {
      launch.disabled = true;
      status.textContent = "Loading the terminal demo…";
      try {
        const { mountPreview } = await import("../scripts/tui-preview");
        await mountPreview({ screen, demo, choices, reset, status });
        fallback.open = false;
        launch.hidden = true;
      } catch {
        recover();
      }
    });

    function recover() {
      demo.hidden = true;
      launch.disabled = false;
      status.textContent = "The terminal demo could not load. Try again or use the text preview.";
      fallback.open = true;
    }
  }
</script>

<style>
  .terminal-preview { margin: 36px 0; }
  button { color: var(--cream); font: inherit; padding: 6px 10px; background: var(--ink-2); border: 1px solid var(--line-2); cursor: pointer; }
  button[aria-pressed="true"] { border-color: var(--amber); }
  button:disabled { cursor: wait; opacity: .65; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; }
  .terminal-screen { height: 16rem; max-inline-size: 100%; overflow: hidden; padding: 8px; background: var(--ink); border: 1px solid var(--line-2); }
  .terminal-screen:focus-within { outline: 2px solid var(--amber); outline-offset: 2px; }
  #terminal-preview-help { color: var(--muted); font-size: .9rem; }
  summary { cursor: pointer; }
</style>
