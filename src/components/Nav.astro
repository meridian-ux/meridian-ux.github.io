---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (prefix) => path === prefix || path.startsWith(prefix + "/") ? "page" : undefined;
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Meridian home">
    <img src="/assets/meridian-mark.png" alt="" width="24" height="24" />
    Meridian
  </a>
  <nav aria-label="Main">
    <a href="/#primitives">Elements</a>
    <a href="/features/" aria-current={current("/features")}>Renderers</a>
    <a href="/conformance/" aria-current={current("/conformance")}>Conformance</a>
    <a href="/#start">Get started</a>
  </nav>
</header>

<style>
  .site-header { display: flex; justify-content: space-between; align-items: center; gap: 12px 28px; flex-wrap: wrap; padding: 18px 0; border-bottom: 1px solid var(--line-2); }
  .wordmark { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
  nav { display: flex; align-items: center; gap: 8px 20px; flex-wrap: wrap; }
  nav a { font-size: .875rem; color: var(--muted); }
  nav a:hover, nav a[aria-current="page"] { color: var(--cream); text-decoration: underline; text-underline-offset: .26em; }
</style>
