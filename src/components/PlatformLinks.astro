---
const platforms = [
  { path: "/start/web/", name: "Web", detail: "Render a descriptor in React and learn how providers and kits fit together." },
  { path: "/start/swiftui/", name: "SwiftUI", detail: "Build the native preview for macOS and iOS from source." },
  { path: "/start/terminal/", name: "Terminal", detail: "Run the offline viewer or embed a panel in a Rust application." },
  { path: "/start/wasm/", name: "WebAssembly", detail: "Build and integrate the shared Rust runtime." },
];
---
<ul class="platforms">
  {platforms.map(({ path, name, detail }) => <li><a href={path}><strong>{name}</strong><span>{detail}</span></a></li>)}
</ul>
<style>
  .platforms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; padding: 0; margin: 24px 0 0; list-style: none; }
  li { border-top: 1px solid var(--line); min-width: 0; }
  a { display: block; padding: 14px 0; }
  a:hover strong { text-decoration: underline; text-underline-offset: .25em; }
  strong { display: block; }
  span { color: var(--muted); }
  @media (max-width: 580px) { .platforms { grid-template-columns: minmax(0, 1fr); } }
</style>
