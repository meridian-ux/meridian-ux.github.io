---
import Base from "./Base.astro";
const { title, description } = Astro.props;
---
<Base title={`${title} — Meridian`} description={description}>
  <article class="guide">
    <nav aria-label="Guide navigation"><a href="/start/">Get started</a></nav>
    <header>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <slot />
  </article>
</Base>
<style>
  .guide { max-inline-size: 76ch; padding: clamp(40px, 8vw, 80px) 0; overflow-wrap: anywhere; }
  nav a, .guide :global(a) { text-decoration: underline; text-underline-offset: .24em; }
  h1 { margin: 14px 0 0; font-size: clamp(2.6rem, 6vw, 4.5rem); letter-spacing: -.055em; line-height: 1.05; }
  header p { color: var(--muted); font-size: 1.15rem; margin: 12px 0 32px; }
  .guide :global(h2) { font-size: clamp(1.45rem, 4vw, 2rem); letter-spacing: -.035em; line-height: 1.15; margin: 36px 0 10px; }
  .guide :global(p) { margin: 10px 0 16px; }
  .guide :global(pre.astro-code) { max-inline-size: 100%; overflow: auto; padding: 12px 14px; border: 1px solid var(--line-2); font: .82rem/1.6 var(--mono); }
  .guide :global(code) { overflow-wrap: anywhere; }
</style>
