---
import Base from "../../layouts/Base.astro";
import catalog from "../../content/features.json";

const title = "Renderers — Meridian";
const description = "Explore Meridian renderers for the web, SwiftUI, and the terminal, plus the shared Rust core compiled to WebAssembly.";
const features = catalog.features;
---
<Base title={title} description={description}>
  <section class="feature-hero">
    <h1>Renderers</h1>
    <p class="sub">Render the same Meridian descriptor on the web, in a SwiftUI app, or in the terminal. The shared Rust core, compiled to WebAssembly, helps keep interaction behavior consistent across the web and terminal renderers.</p>
  </section>

  <section style="padding-top:0">
    <div class="feature-grid">
      {features.map((f) => (
        <a class="fcard" href={`/features/${f.slug}`}>
          <div class="top">
            <span class="fname">{f.name}</span>
            <span class={`pill ${(f.status || "available").toLowerCase()}`}>{(f.status || "available").toLowerCase()}</span>
          </div>
          <span class="cat">{f.category?.toLowerCase()}</span>
          <p class="ftag">{f.tagline}</p>
          <span class="more">Learn more →</span>
        </a>
      ))}
    </div>
  </section>
</Base>
