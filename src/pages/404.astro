---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — Meridian" description="The requested Meridian page could not be found." noindex>
  <section class="close" style="border-top:0; padding-top:clamp(80px,14vw,180px)">
    <span class="eyebrow" style="justify-content:center; display:flex">error · 404</span>
    <h1 style="margin-top:16px">Page not found</h1>
    <p>The page may have moved. You can return home or browse Meridian’s renderers.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/">Back home</a>
      <a class="btn btn-ghost" href="/features/">Browse renderers →</a>
    </div>
  </section>
</Base>
