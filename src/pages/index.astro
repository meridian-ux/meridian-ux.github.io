---
import Base from "../layouts/Base.astro";
import Gallery from "../components/Gallery.astro";
---
<Base title="Meridian — A design language for interfaces" description="Explore Meridian’s typed UI elements, theme foundations, and renderer coverage.">
  <header class="intro">
    <h1>A design language<br />for interfaces.</h1>
    <p>Describe an interface with Protocol Buffers. Render it on the web, in SwiftUI, or in the terminal.</p>
    <a href="#primitives">Explore the elements ↓</a>
  </header>

  <Gallery />

  <section class="chapter" id="skins">
    <h2>Foundations</h2>
    <p>The Meridian theme pairs cool neutrals with an azure-to-violet accent.</p>
    <ul class="swatches" aria-label="Meridian brand palette">
      {[
        ["Ink", "#131419"], ["Paper", "#E9EAF3"], ["Cyan", "#3ED9E0"],
        ["Azure", "#6E8BFF"], ["Violet", "#9A7CF0"], ["Green", "#57D98B"],
      ].map(([label, value]) => (
        <li><span style={`background:${value}`}></span>{label}<code>{value}</code></li>
      ))}
    </ul>
    <div class="type-samples">
      <div><strong>4 px</strong><p>Spacing unit</p></div>
      <div><strong>8 px</strong><p>Component radius</p></div>
      <div><strong>Space Grotesk</strong><p>Display and interface</p></div>
      <div><code>System mono</code><p>Descriptors, commands, and data</p></div>
    </div>
  </section>

  <section class="chapter" id="semantics">
    <h2>Shared semantics</h2>
    <dl class="semantics">
      <div><dt>Tone</dt><dd><span>Neutral</span> <span class="info">Info</span> <span class="success">Success</span> <span class="warning">Warning</span> <span class="danger">Danger</span> <span class="accent">Accent</span></dd></div>
      <div><dt>Action emphasis</dt><dd><strong>Publish</strong> <span>Save draft</span></dd></div>
      <div><dt>Value display</dt><dd><code>0.9998</code> <span aria-hidden="true">→</span> 99.98% availability</dd></div>
      <div><dt>Layout</dt><dd>List, stacked, tabbed, and two-column</dd></div>
      <div><dt>Degradation</dt><dd>Live interaction → snapshot → metadata → placeholder</dd></div>
    </dl>
    <a href="https://github.com/meridian-ux/meridian/blob/main/schemas/DESIGN_LANGUAGE.md">Read the design language contract ↗</a>
  </section>

  <section class="chapter" id="thesis">
    <h2>One typed contract</h2>
    <p id="pipeline">Descriptors define the structure, a renderer draws the interface, and <code>meridian.theme.v1</code> supplies the palette, typography, and metrics.</p>
    <a id="renderers" href="/features/">Explore the renderers →</a>
  </section>

  <section class="chapter" id="start">
    <h2>Get started</h2>
    <p>Choose a renderer, author a descriptor, and pass it to the renderer on your target surface.</p>
    <a href="https://github.com/meridian-ux/meridian">Read the source and installation guides ↗</a>
  </section>
</Base>

<style>
  .intro { padding: clamp(72px, 13vw, 150px) 0 clamp(64px, 10vw, 112px); }
  .intro h1 { font-size: clamp(3rem, 8.2vw, 7.25rem); line-height: .98; letter-spacing: -.075em; margin: 0; font-weight: 600; }
  .intro p, .chapter > p { max-width: 58ch; color: var(--muted); }
  .intro p { font-size: clamp(1.04rem, 2vw, 1.3rem); margin: 28px 0 20px; }
  .intro a, .chapter a { text-decoration: underline; text-underline-offset: .28em; }
  .chapter { border-top: 1px solid var(--line-2); padding: 52px 0; }
  .chapter h2 { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.05em; margin: 0; }
  .swatches { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; list-style: none; margin: 30px 0; padding: 0; }
  .swatches code { display: block; color: var(--muted); font-size: .75rem; }
  .swatches span { display: block; height: 52px; border: 1px solid var(--line-2); border-radius: 2px; margin-bottom: 6px; }
  .semantics { margin: 20px 0; }
  .semantics div { display: grid; grid-template-columns: minmax(95px, 1fr) 3fr; gap: 8px 20px; border-top: 1px solid var(--line); padding: 10px 0; }
  .semantics dd { margin: 0; }
  .semantics dd span { display: inline-block; margin-inline-end: 8px; }
  .info { color: #3ed9e0; }
  .success { color: var(--ok); }
  .warning { color: var(--gold); }
  .danger { color: var(--block); }
  .accent { color: var(--amber); }
  .type-samples { display: flex; flex-wrap: wrap; gap: 20px 60px; }
  .type-samples strong, .type-samples code { font-size: 1.25rem; }
  .type-samples p { color: var(--muted); margin: 0; }
  @media (max-width: 520px) { .swatches { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
